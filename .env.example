# ─── WhatsApp Bot ─────────────────────────────────────────────────────────────

# Comma-separated WhatsApp numbers allowed to run /balance and /logout.
# Format: country code + number, no spaces or + sign.
# Example (South Africa): 27821234567,27831234567
ALLOWED_NUMBERS=27821234567

# ─── Capitec Internet Banking ─────────────────────────────────────────────────

# Your Capitec internet banking username (as shown at internet.capitecbank.co.za)
CAPITEC_USERNAME=your_username_here

# Your Capitec internet banking password
CAPITEC_PASSWORD=your_password_here

# Base URL for Capitec internet banking (change only if they update their URL)
CAPITEC_URL=https://internet.capitecbank.co.za

# ─── Optional: override CSS selectors if Capitec updates their UI ─────────────
# Leave these commented out unless the bot stops working after a Capitec UI update.

# CAPITEC_SEL_USERNAME=input[name="username"]
# CAPITEC_SEL_PASSWORD=input[type="password"]
# CAPITEC_SEL_SUBMIT=button[type="submit"]
# CAPITEC_SEL_OTP=input[name="otp"]
# CAPITEC_SEL_BALANCE=[class*="balance"]
# CAPITEC_SEL_ACCOUNT=[class*="account"]

# ─── Existing game server (leave as-is) ───────────────────────────────────────
PORT=3000
# EMAIL=your_gmail@gmail.com
# CLIENT_ID=
# CLIENT_SECRET=
# REFRESH_TOKEN=
